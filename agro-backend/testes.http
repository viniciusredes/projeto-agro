# =====================================================================
#  Roteiro de testes da API — Agro Backend
# =====================================================================
#
#  Como usar:
#  1. Instale a extensão "REST Client" (autor: Huachao Mao) no VS Code.
#  2. Rode o servidor:  npm run dev
#  3. Clique em "Send Request", que aparece acima de cada requisição.
#
#  IMPORTANTE: execute os testes EM ORDEM, com o servidor recém-iniciado
#  (salve o server.ts para zerar os dados). Cada teste depende do estado
#  deixado pelos anteriores.
#
#  Os códigos (M0, S1, R4...) são os mesmos da seção 6 do README.md.
# =====================================================================

@baseUrl = http://localhost:3000


# =====================================================================
#  GET /maquinas
# =====================================================================

### M0 — Listar máquinas
# Esperado: 200, as 2 máquinas com status "Disponível"
GET {{baseUrl}}/maquinas


# =====================================================================
#  POST /maquinas/:id/saida
# =====================================================================

### S1 — Saída válida da máquina 1
# Esperado: 200, status "Em Operação", movimentação 1 aberta
POST {{baseUrl}}/maquinas/1/saida
Content-Type: application/json

{
  "operador": "João",
  "frenteTrabalho": "Talhão 5"
}

### S2 — Saída da máquina 1 de novo (já está em operação)
# Esperado: 409, "não pode sair: status atual é 'Em Operação'"
POST {{baseUrl}}/maquinas/1/saida
Content-Type: application/json

{
  "operador": "João",
  "frenteTrabalho": "Talhão 5"
}

### S3 — Máquina inexistente
# Esperado: 404, "Máquina não encontrada"
POST {{baseUrl}}/maquinas/99/saida
Content-Type: application/json

{
  "operador": "João",
  "frenteTrabalho": "Talhão 5"
}

### S4 — Sem corpo
# Esperado: 400, "Campo 'operador' é obrigatório"
POST {{baseUrl}}/maquinas/2/saida

### S5 — Operador só com espaços
# Esperado: 400, "Campo 'operador' é obrigatório"
POST {{baseUrl}}/maquinas/2/saida
Content-Type: application/json

{
  "operador": "   ",
  "frenteTrabalho": "Talhão 8"
}

### S6 — Sem frenteTrabalho
# Esperado: 400, "Campo 'frenteTrabalho' é obrigatório"
POST {{baseUrl}}/maquinas/2/saida
Content-Type: application/json

{
  "operador": "Maria"
}

### S7 — JSON mal formado (sem aspas nos nomes dos campos)
# Esperado: 400, "JSON inválido no corpo da requisição" (em JSON, não em HTML!)
POST {{baseUrl}}/maquinas/2/saida
Content-Type: application/json

{operador: Maria}

### S8 — JSON sem o cabeçalho Content-Type
# Esperado: 400, "Campo 'operador' é obrigatório"
# Sem o cabeçalho, o express.json() não lê o corpo e o req.body fica vazio.
POST {{baseUrl}}/maquinas/2/saida

{
  "operador": "Maria",
  "frenteTrabalho": "Talhão 8"
}


# =====================================================================
#  POST /maquinas/:id/retorno
# =====================================================================

### R1 — Retorno de máquina que não saiu (máquina 2 está disponível)
# Esperado: 409, "não pode retornar: status atual é 'Disponível'"
POST {{baseUrl}}/maquinas/2/retorno
Content-Type: application/json

{
  "horimetro": 510
}

### R2 — Máquina inexistente
# Esperado: 404, "Máquina não encontrada"
POST {{baseUrl}}/maquinas/99/retorno
Content-Type: application/json

{
  "horimetro": 510
}

### R3 — Sem corpo
# Esperado: 400, "Campo 'horimetro' é obrigatório e deve ser um número"
POST {{baseUrl}}/maquinas/1/retorno

### R4 — Horímetro como texto
# Esperado: 400, "Campo 'horimetro' é obrigatório e deve ser um número"
POST {{baseUrl}}/maquinas/1/retorno
Content-Type: application/json

{
  "horimetro": "1012"
}

### R5 — Avarias com tipo errado (número em vez de texto)
# Esperado: 400, "Campo 'avarias', quando informado, deve ser um texto"
POST {{baseUrl}}/maquinas/1/retorno
Content-Type: application/json

{
  "horimetro": 1012.3,
  "avarias": 123
}

### R6 — Horímetro menor que o atual
# Esperado: 400, "Horímetro informado (900) é menor que o atual (1000)"
POST {{baseUrl}}/maquinas/1/retorno
Content-Type: application/json

{
  "horimetro": 900
}

### R7 — Retorno válido com avarias
# Esperado: 200, horasTrabalhadas: 12.3, avarias gravado
POST {{baseUrl}}/maquinas/1/retorno
Content-Type: application/json

{
  "horimetro": 1012.3,
  "avarias": "Vazamento de óleo no hidráulico"
}


# =====================================================================
#  GET /movimentacoes
# =====================================================================

### H1 — Histórico após o R7
# Esperado: 200, 1 movimentação fechada (12.3 h, com avarias)
GET {{baseUrl}}/movimentacoes

### H2 — Saída da máquina 2 (preparação para os próximos testes)
# Esperado: 200, movimentação 2 aberta
POST {{baseUrl}}/maquinas/2/saida
Content-Type: application/json

{
  "operador": "Maria",
  "frenteTrabalho": "Talhão 8"
}

### H3 — Filtro por máquina
# Esperado: 200, só a movimentação 2, SEM dataRetorno (a máquina está em campo)
GET {{baseUrl}}/movimentacoes?maquinaId=2

### H4 — Filtro inválido
# Esperado: 400, "Parâmetro 'maquinaId' deve ser um número inteiro"
GET {{baseUrl}}/movimentacoes?maquinaId=abc

### H5 — Retorno da máquina 2 sem avarias
# Esperado: 200, horasTrabalhadas: 10, SEM o campo avarias
POST {{baseUrl}}/maquinas/2/retorno
Content-Type: application/json

{
  "horimetro": 510
}

### H6 — Histórico final
# Esperado: 200, 2 movimentações fechadas
GET {{baseUrl}}/movimentacoes


# =====================================================================
#  Comportamentos globais
# =====================================================================

### G1 — Rota inexistente
# Esperado: 404, "Rota GET /xyz não existe"
GET {{baseUrl}}/xyz

### G2 — Método não suportado numa rota existente
# Esperado: 404, "Rota DELETE /maquinas não existe"
DELETE {{baseUrl}}/maquinas

### G3 — Cabeçalhos da resposta
# Esperado: 200, e nos cabeçalhos NÃO deve aparecer "X-Powered-By"
GET {{baseUrl}}/maquinas


# #####################################################################
#  MÓDULO DE ESTOQUE
# #####################################################################

# =====================================================================
#  GET /pecas e GET /pecas/:id
# =====================================================================

### P1 — Listar peças
# Esperado: 200, as 3 peças iniciais (FLT-001, OLE-001, COR-001)
GET {{baseUrl}}/pecas

### P2 — Buscar peça existente
# Esperado: 200, Óleo hidráulico (OLE-001)
GET {{baseUrl}}/pecas/2

### P3 — Peça inexistente
# Esperado: 404, "Peça não encontrada"
GET {{baseUrl}}/pecas/99

### P4 — Id inválido
# Esperado: 400, "O id deve ser um número inteiro"
GET {{baseUrl}}/pecas/abc


# =====================================================================
#  POST /pecas (cadastro)
# =====================================================================

### C1 — Cadastro válido
# Esperado: 201, código gravado como "FLT-002", saldo 0 e custo 0
POST {{baseUrl}}/pecas
Content-Type: application/json

{
  "codigo": " flt-002 ",
  "descricao": "Filtro de ar",
  "unidade": "un",
  "estoqueMinimo": 3
}

### C2 — Código repetido
# Esperado: 409, "Já existe uma peça com o código FLT-002"
POST {{baseUrl}}/pecas
Content-Type: application/json

{
  "codigo": "FLT-002",
  "descricao": "Outro",
  "unidade": "un"
}

### C3 — Unidade inválida
# Esperado: 400, "Campo 'unidade' deve ser um destes: un, L"
POST {{baseUrl}}/pecas
Content-Type: application/json

{
  "codigo": "GRX-001",
  "descricao": "Graxa",
  "unidade": "kg"
}

### C4 — Saldo informado no cadastro
# Esperado: 400, "... Use a entrada de estoque (compra) para abastecer a peça"
POST {{baseUrl}}/pecas
Content-Type: application/json

{
  "codigo": "GRX-001",
  "descricao": "Graxa",
  "unidade": "un",
  "saldo": 50
}

### C5 — Estoque mínimo fracionado em peça contada por unidade
# Esperado: 400, "... 'estoqueMinimo' deve ser um número inteiro"
POST {{baseUrl}}/pecas
Content-Type: application/json

{
  "codigo": "GRX-001",
  "descricao": "Graxa",
  "unidade": "un",
  "estoqueMinimo": 2.5
}

### C6 — Sem código
# Esperado: 400, "Campo 'codigo' é obrigatório"
POST {{baseUrl}}/pecas
Content-Type: application/json

{
  "descricao": "Graxa",
  "unidade": "un"
}


# =====================================================================
#  POST /pecas/:id/entradas (compra)
# =====================================================================

### E1 — Compra de filtros
# Esperado: 200, saldo 10 -> 15, custo 85.9 -> 92.46 (arredondado), custoAnterior 85.9
POST {{baseUrl}}/pecas/1/entradas
Content-Type: application/json

{
  "quantidade": 5,
  "custoUnitario": 92.456
}

### E2 — Conferir a peça após a compra
# Esperado: 200, saldo 15 e custoUnitario 92.46 (custo da última compra)
GET {{baseUrl}}/pecas/1

### E3 — Compra fracionada em litros
# Esperado: 200, saldo 200 -> 220.5
POST {{baseUrl}}/pecas/2/entradas
Content-Type: application/json

{
  "quantidade": 20.5,
  "custoUnitario": 19.9
}

### E4 — Quantidade fracionada em peça contada por unidade
# Esperado: 400, "A peça FLT-001 é contada em unidades: a quantidade deve ser um número inteiro"
POST {{baseUrl}}/pecas/1/entradas
Content-Type: application/json

{
  "quantidade": 1.5,
  "custoUnitario": 90
}

### E5 — Quantidade zero
# Esperado: 400, "Campo 'quantidade' deve ser um número maior que zero"
POST {{baseUrl}}/pecas/1/entradas
Content-Type: application/json

{
  "quantidade": 0,
  "custoUnitario": 90
}

### E6 — Custo negativo
# Esperado: 400, "Campo 'custoUnitario' deve ser um número maior que zero"
POST {{baseUrl}}/pecas/1/entradas
Content-Type: application/json

{
  "quantidade": 5,
  "custoUnitario": -1
}

### E7 — Peça inexistente
# Esperado: 404, "Peça não encontrada"
POST {{baseUrl}}/pecas/99/entradas
Content-Type: application/json

{
  "quantidade": 5,
  "custoUnitario": 90
}


# =====================================================================
#  GET /pecas/:id/movimentos (kardex)
# =====================================================================

### K1/K2 — Kardex do filtro
# Esperado: 200, 2 movimentos: implantação (10, saldo após 10) e entrada (5, saldo após 15)
GET {{baseUrl}}/pecas/1/movimentos

### K3 — Kardex de peça nova, sem compras
# Esperado: 200, []
GET {{baseUrl}}/pecas/4/movimentos

### K4 — Kardex de peça inexistente
# Esperado: 404, "Peça não encontrada"
GET {{baseUrl}}/pecas/99/movimentos


# =====================================================================
#  GET /pecas?abaixoDoMinimo=true (reposição)
# =====================================================================

### A1 — Peças abaixo do mínimo
# Esperado: 200, correia COR-001 (saldo 4 < mínimo 5, faltaParaMinimo 1)
#           e o filtro de ar FLT-002 (saldo 0 < mínimo 3)
GET {{baseUrl}}/pecas?abaixoDoMinimo=true

### A2 — Filtro com valor inválido
# Esperado: 400, "Parâmetro 'abaixoDoMinimo' só aceita o valor 'true'"
GET {{baseUrl}}/pecas?abaixoDoMinimo=sim

### A3 — Compra de correias (preparação)
# Esperado: 200, saldo 4 -> 10
POST {{baseUrl}}/pecas/3/entradas
Content-Type: application/json

{
  "quantidade": 6,
  "custoUnitario": 118
}

### A4 — Correia sai da lista de reposição
# Esperado: 200, só o filtro de ar FLT-002 (a correia NÃO aparece mais)
GET {{baseUrl}}/pecas?abaixoDoMinimo=true


# #####################################################################
#  MÓDULO DE MANUTENÇÃO (ORDENS DE SERVIÇO)
#  Estado herdado dos testes anteriores:
#  - TR-01 disponível com horímetro 1012.3; CO-02 disponível com 510
#  - Filtro FLT-001: saldo 15, custo 92.46 | Óleo OLE-001: saldo 220.5, custo 19.9
# #####################################################################

# =====================================================================
#  POST /ordens-servico (abertura)
# =====================================================================

### O1 — Nenhuma O.S. no início
# Esperado: 200, []
GET {{baseUrl}}/ordens-servico

### O2 — Abrir O.S. com a máquina disponível
# Esperado: 201, O.S. nº 1 "Aberta" e TR-01 "Em Manutenção"
POST {{baseUrl}}/ordens-servico
Content-Type: application/json

{
  "maquinaId": 1,
  "tipo": "Preventiva",
  "descricao": "Revisão 1000 h",
  "horimetro": 1012.3
}

### O3 — Segunda O.S. para a mesma máquina
# Esperado: 409, "Máquina TR-01 já está em manutenção (O.S. nº 1 aberta)"
POST {{baseUrl}}/ordens-servico
Content-Type: application/json

{
  "maquinaId": 1,
  "tipo": "Corretiva",
  "descricao": "Outro problema",
  "horimetro": 1012.3
}

### O4 — Saída de máquina em manutenção
# Esperado: 409, "não pode sair: status atual é 'Em Manutenção'"
POST {{baseUrl}}/maquinas/1/saida
Content-Type: application/json

{
  "operador": "João",
  "frenteTrabalho": "Talhão 5"
}

### O5 — maquinaId como texto
# Esperado: 400, "Campo 'maquinaId' é obrigatório e deve ser um número inteiro"
POST {{baseUrl}}/ordens-servico
Content-Type: application/json

{
  "maquinaId": "2",
  "tipo": "Corretiva",
  "descricao": "X",
  "horimetro": 510
}

### O6 — Máquina inexistente
# Esperado: 404, "Máquina não encontrada"
POST {{baseUrl}}/ordens-servico
Content-Type: application/json

{
  "maquinaId": 99,
  "tipo": "Corretiva",
  "descricao": "X",
  "horimetro": 1
}

### O7 — Tipo inválido
# Esperado: 400, "Campo 'tipo' deve ser um destes: Preventiva, Corretiva"
POST {{baseUrl}}/ordens-servico
Content-Type: application/json

{
  "maquinaId": 2,
  "tipo": "Urgente",
  "descricao": "X",
  "horimetro": 510
}

### O8 — Horímetro menor que o atual
# Esperado: 400, "Horímetro informado (400) é menor que o atual (510)"
POST {{baseUrl}}/ordens-servico
Content-Type: application/json

{
  "maquinaId": 2,
  "tipo": "Corretiva",
  "descricao": "X",
  "horimetro": 400
}


# =====================================================================
#  Abertura de O.S. com a máquina em campo
# =====================================================================

### O9 — Saída da CO-02 (preparação)
# Esperado: 200, CO-02 "Em Operação"
POST {{baseUrl}}/maquinas/2/saida
Content-Type: application/json

{
  "operador": "Maria",
  "frenteTrabalho": "Talhão 8"
}

### O10 — O.S. com a máquina em campo
# Esperado: 201, a saída é encerrada automaticamente:
#           movimentacaoEncerrada com horasTrabalhadas 7.5 e avarias "O.S. nº 2: Correia partiu"
POST {{baseUrl}}/ordens-servico
Content-Type: application/json

{
  "maquinaId": 2,
  "tipo": "Corretiva",
  "descricao": "Correia partiu",
  "horimetro": 517.5
}

### O11 — Retorno depois da O.S.
# Esperado: 409, "não pode retornar: status atual é 'Em Manutenção'"
POST {{baseUrl}}/maquinas/2/retorno
Content-Type: application/json

{
  "horimetro": 520
}

### O12 — Histórico da CO-02
# Esperado: 200, movimentação fechada com a avaria "O.S. nº 2: Correia partiu"
GET {{baseUrl}}/movimentacoes?maquinaId=2


# =====================================================================
#  POST /ordens-servico/:id/fechamento
# =====================================================================

### F1 — O.S. inexistente
# Esperado: 404, "Ordem de serviço não encontrada"
POST {{baseUrl}}/ordens-servico/99/fechamento

### F2 — 'pecas' não é uma lista
# Esperado: 400, "Campo 'pecas', quando informado, deve ser uma lista"
POST {{baseUrl}}/ordens-servico/1/fechamento
Content-Type: application/json

{
  "pecas": { "pecaId": 1 }
}

### F3 — Peça repetida
# Esperado: 400, "A peça FLT-001 aparece mais de uma vez: informe a quantidade total numa única linha"
POST {{baseUrl}}/ordens-servico/1/fechamento
Content-Type: application/json

{
  "pecas": [
    { "pecaId": 1, "quantidade": 1 },
    { "pecaId": 1, "quantidade": 1 }
  ]
}

### F4 — Peça inexistente na lista
# Esperado: 404, "Item 2: peça 99 não encontrada"
POST {{baseUrl}}/ordens-servico/1/fechamento
Content-Type: application/json

{
  "pecas": [
    { "pecaId": 1, "quantidade": 1 },
    { "pecaId": 99, "quantidade": 1 }
  ]
}

### F5 — Estoque insuficiente (tudo ou nada)
# Esperado: 409, "Estoque insuficiente: FLT-001 (pedido 20, saldo 15). Nenhuma baixa foi realizada."
# O óleo TEM saldo, mas também não é baixado, porque o fechamento é recusado por inteiro.
POST {{baseUrl}}/ordens-servico/1/fechamento
Content-Type: application/json

{
  "pecas": [
    { "pecaId": 2, "quantidade": 10 },
    { "pecaId": 1, "quantidade": 20 }
  ]
}

### F6 — Saldo do óleo intacto após o erro
# Esperado: 200, saldo 220.5 (nada foi baixado)
GET {{baseUrl}}/pecas/2

### F7 — Fechamento com baixa de peças
# Esperado: 200, itens com custo congelado:
#           2 x 92.46 = 184.92 + 15.5 x 19.9 = 308.45 -> custoTotal 493.37
POST {{baseUrl}}/ordens-servico/1/fechamento
Content-Type: application/json

{
  "pecas": [
    { "pecaId": 1, "quantidade": 2 },
    { "pecaId": 2, "quantidade": 15.5 }
  ]
}

### F8 — Kardex do filtro
# Esperado: 200, movimento "saida" de 2 unidades com ordemServicoId 1
GET {{baseUrl}}/pecas/1/movimentos

### F9 — Saldo do filtro após a baixa
# Esperado: 200, saldo 13 (15 - 2)
GET {{baseUrl}}/pecas/1

### F10 — Fechar O.S. já fechada
# Esperado: 409, "O.S. nº 1 já está fechada"
POST {{baseUrl}}/ordens-servico/1/fechamento

### F11 — Fechar O.S. sem peças
# Esperado: 200, custoTotal 0 e CO-02 volta a "Disponível"
POST {{baseUrl}}/ordens-servico/2/fechamento

### F12 — Máquinas após os fechamentos
# Esperado: 200, TR-01 e CO-02 "Disponível" (CO-02 com horímetro 517.5)
GET {{baseUrl}}/maquinas


# =====================================================================
#  Consultas de O.S. e custo congelado
# =====================================================================

### Q1 — Detalhe da O.S. com os dados da máquina
# Esperado: 200, O.S. nº 1 com "maquina": { "tag": "TR-01", "modelo": "Trator" }
GET {{baseUrl}}/ordens-servico/1

### Q2 — O.S. inexistente
# Esperado: 404, "Ordem de serviço não encontrada"
GET {{baseUrl}}/ordens-servico/99

### Q3 — Filtros combinados
# Esperado: 200, só a O.S. nº 2 (CO-02, fechada)
GET {{baseUrl}}/ordens-servico?maquinaId=2&status=Fechada

### Q4 — Status inválido no filtro
# Esperado: 400, "Parâmetro 'status' deve ser um destes: Aberta, Fechada"
GET {{baseUrl}}/ordens-servico?status=aberta

### Q5 — Custo de manutenção da TR-01
# Esperado: 200, custoTotal 493.37 e custoPorTipo { Preventiva: 493.37, Corretiva: 0 }
GET {{baseUrl}}/maquinas/1/manutencoes

### Q6 — Manutenções de máquina inexistente
# Esperado: 404, "Máquina não encontrada"
GET {{baseUrl}}/maquinas/99/manutencoes

### Q7 — Compra de filtros mais cara (preparação)
# Esperado: 200, custo do filtro passa de 92.46 para 110
POST {{baseUrl}}/pecas/1/entradas
Content-Type: application/json

{
  "quantidade": 5,
  "custoUnitario": 110
}

### Q8 — Custo congelado
# Esperado: 200, a O.S. nº 1 continua com o filtro a 92.46 e custoTotal 493.37
GET {{baseUrl}}/ordens-servico/1
