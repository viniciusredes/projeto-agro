# Copie este arquivo para ".env.local" e troque o IP pelo do SEU computador na rede Wi-Fi.
# No Windows: rode "ipconfig" e use o "Endereço IPv4" do adaptador Wi-Fi.
# O celular e o computador precisam estar na MESMA rede.
#
# Só variáveis com o prefixo EXPO_PUBLIC_ chegam ao app (e ficam visíveis dentro dele:
# nunca coloque senhas aqui).
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
